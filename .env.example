# ---------------------------------------------------------------------------
# Summit Shield Roofing — Whop Website template
# Copy to .env.local for local builds. NEVER put real secret values here.
# ---------------------------------------------------------------------------

# ---- Whop server-side credentials (server-only, never exposed to browser) --
# Whop's hosting runtime injects a scoped app API key automatically; the
# server routes in this template call Whop through WHOP_API_ORIGIN and do not
# need a manual key. Provide one only if you self-host the API layer.
WHOP_API_KEY=

# Injected automatically by the Whop runtime / whop apps dev. Listed for
# completeness — do not commit values.
WHOP_APP_ID=
WHOP_COMPANY_ID=

# ---- Public build-time configuration (safe to expose to the browser) ------
# The public route (URL slug) or biz_ ID of the company that owns the plans.
# Public information: it appears in Whop URLs. Scoped into the Vite bundle.
VITE_WHOP_COMPANY_ROUTE=

# ---- Whop plan/product IDs (env-driven; never hardcode account data) ------
# Create in the Whop dashboard (or via `whop plans create`) and paste IDs here.
WHOP_PRODUCT_ID=
WHOP_INSPECTION_PLAN_ID=
WHOP_DEPOSIT_PLAN_ID=
WHOP_EMERGENCY_REPAIR_PLAN_ID=

# The user_ ID that estimate-form leads are attributed to (public ID).
# The Leads API requires a user when authenticating as an app/company.
WHOP_LEAD_USER_ID=

# ---- Admin protection ------------------------------------------------------
# Long random string. Required by POST /api/admin/final-invoice (x-admin-secret).
INVOICE_ADMIN_SECRET=
